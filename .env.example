# PrognosOps 环境变量示例
# 复制本文件为 .env 并填入真实值,严禁将 .env 提交到代码仓库

# ─── 运行时 AI Agent 模型配置 ───
# OpenAI 兼容 API 基础地址(含 /v1 或裸域名,不含 /chat/completions)
# DeepSeek 示例:https://api.deepseek.com
# OpenAI 示例:https://api.openai.com/v1
MODEL_BASE_URL=https://api.deepseek.com
# 模型 API Key(仅后端读取,严禁出现在前端代码中)
# DeepSeek 示例:sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL_API_KEY=
# 模型名称
# DeepSeek 可选:deepseek-chat(V3,快)/ deepseek-reasoner(R1,推理)/ deepseek-flash(推理)
MODEL_NAME=deepseek-chat
# 请求超时(秒,推理模型建议 ≥60)
MODEL_TIMEOUT=60

# ─── 服务配置 ───
HOST=0.0.0.0
PORT=8080